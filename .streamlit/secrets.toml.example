# Copy this file to .streamlit/secrets.toml for local use (it's ignored by git),
# or paste these lines into Streamlit Community Cloud: App -> Settings -> Secrets.

ANTHROPIC_API_KEY = "sk-ant-your-key-here"

# Visitors must enter this to write NEW AI analyses on your key.
# Saved analyses are still visible to everyone. Leave it out to let anyone write them.
AI_PASSWORD = "choose-a-password"

# Max new AI analyses per day on your key (protects your credit).
AI_DAILY_LIMIT = "25"

# Model used online: claude-sonnet-5-5 (balanced), claude-haiku-5-5 (cheapest), claude-opus-5-5 (most thorough)
AI_MODEL = "claude-sonnet-5-5"

# Set to "1" online: hides the Ollama option, which only works on your own computer.
HOSTED = "1"
